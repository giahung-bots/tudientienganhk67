int main(void) {
#ifdef _WIN32
    SetConsoleOutputCP(CP_UTF8);                        // hiện được tiếng Việt
    SetConsoleCP(CP_UTF8);
    HANDLE h = GetStdHandle(STD_OUTPUT_HANDLE);         // bật màu ANSI
    DWORD mode = 0;
    GetConsoleMode(h, &mode);
    SetConsoleMode(h, mode | 0x0004);
#endif
    srand((unsigned)time(NULL));

    // Khởi tạo trạng thái
    app.huongViEn = 0;
    app.chuDe = -1;
    app.isAdmin = 0;
    doc_tu_tu_file();
    doc_danh_sach_chuoi(FILE_YT, app.favs, &app.soFav, MAX_YEUTHICH);
    doc_danh_sach_chuoi(FILE_LS, app.hist, &app.soHist, MAX_LICHSU);
    doc_giao_dien();
    ap_dung_giao_dien();

    // Vòng lặp menu chính
    while (1) {
        in_tieu_de("TỪ ĐIỂN ANH - VIỆT");
        printf("1. 🔍 Tra từ\n");
        printf("2. 📇 Thẻ từ (flashcard)\n");
        printf("3. 🧩 Đố vui\n");
        printf("4. ❤️  Đã lưu (%d)\n", app.soFav);
        printf("5. 🕘 Lịch sử (%d)\n", app.soHist);
        printf("6. ⚙️  Quản trị\n");
        printf("7. ⇄  Đổi chiều tra (hiện: %s)\n", app.huongViEn ? "VI -> EN" : "EN -> VI");
        printf("8. 🏷️  Chọn chủ đề (hiện: %s)\n", ten_chu_de());
        printf("9. 🌙 Đổi giao diện sáng / tối\n");
        printf("0. Thoát\n");
        printf("\nChọn: ");

        int c = doc_so();
        if (c == 0) break;
        else if (c == 1) man_hinh_tra_tu("");
        else if (c == 2) man_hinh_flashcard();
        else if (c == 3) man_hinh_quiz();
        else if (c == 4) man_hinh_yeu_thich();
        else if (c == 5) man_hinh_lich_su();
        else if (c == 6) man_hinh_quan_tri();
        else if (c == 7) app.huongViEn = !app.huongViEn;
        else if (c == 8) chon_chu_de();
        else if (c == 9) { app.toi = !app.toi; ap_dung_giao_dien(); }
    }

    printf("Tạm biệt! 👋\n");
    return 0;
}
