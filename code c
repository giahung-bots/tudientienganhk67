// Lưu chuỗi an toàn (không bao giờ tràn bộ nhớ)
void sao_chep(char *dich, const char *nguon, int kichThuoc) {
    snprintf(dich, kichThuoc, "%s", nguon);
}

// Đọc một dòng từ bàn phím, bỏ ký tự xuống dòng
void doc_dong(char *buf, int n) {
    if (!fgets(buf, n, stdin)) {      // hết dữ liệu nhập -> thoát chương trình
        printf("\n");
        exit(0);
    }
    int len = (int)strlen(buf);
    while (len > 0 && (buf[len - 1] == '\n' || buf[len - 1] == '\r')) {
        buf[--len] = '\0';
    }
    for (int i = 0; i < len; i++) {   // '|' dùng để ngăn cách trong file nên đổi thành khoảng trắng
        if (buf[i] == '|') buf[i] = ' ';
    }
}

// Đọc một số nguyên. Nhập sai hoặc để trống thì trả về -1
int doc_so(void) {
    char buf[32];
    doc_dong(buf, sizeof(buf));
    if (!isdigit((unsigned char)buf[0])) return -1;
    return atoi(buf);
}

