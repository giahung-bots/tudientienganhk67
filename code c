/* ---------- Chi tiết một từ ---------- */
void man_hinh_chi_tiet(int idx) {
    Word w = app.words[idx];
    them_lich_su(w.en);

    while (1) {
        in_tieu_de("CHI TIẾT TỪ");
        int yt = (tim_yeu_thich(w.en) >= 0);
        printf("%s%s%s%s  [%s]  %s\n", mau->chinh, DAM, w.en, RESET, w.topic, yt ? "❤️  đã lưu" : "🤍");
        printf("%s%s%s\n", mau->phu, w.ipa, RESET);
        printf("--------------------------------------\n");

        // In tất cả nghĩa của cùng một từ (ví dụ "love" vừa danh từ vừa động từ)
        for (int j = 0; j < app.soTu; j++) {
            Word *g = &app.words[j];
            if (so_sanh_khong_hoa_thuong(g->en, w.en) != 0) continue;
            printf("%s%s%s\n", mau->chinh, g->pos, RESET);
            printf("  %s%s%s\n", DAM, g->vi, RESET);
            if (g->ex[0]) {
                printf("  \"%s\"\n", g->ex);
                printf("  %s%s%s\n", mau->phu, g->exVi, RESET);
            }
            printf("\n");
        }

        printf("1. Đọc tiếng Anh   2. %s   3. Đọc nghĩa tiếng Việt   0. Quay lại\n",
               yt ? "Bỏ lưu" : "Lưu yêu thích");
        printf("Chọn: ");
        int c = doc_so();
        if (c == 0) return;
        if (c == 1) phat_am(w.en, 0);
        if (c == 3) phat_am(w.vi, 1);
        if (c == 2) {
            if (yt) { bo_yeu_thich(w.en); printf("Đã bỏ lưu từ vựng.\n"); }
            else    { them_yeu_thich(w.en); printf("Đã lưu từ vựng.\n"); }
            nhan_enter();
        }
        if (c == 1 || c == 3) nhan_enter();
    }
}

/* ---------- 1. Tra từ ---------- */
void man_hinh_tra_tu(const char *tuKhoiDau) {
    char q[100];
    sao_chep(q, tuKhoiDau, sizeof(q));

    while (1) {
        if (q[0] == '\0') {                        // chưa có từ khóa -> hỏi
            in_tieu_de("TRA TỪ");
            printf("📖 Đang có %d từ vựng khả dụng.\n", dem_tu_trong_chu_de());
            printf("Nhập từ cần tra (%s, Enter để quay lại): ",
                   app.huongViEn ? "tiếng Việt" : "tiếng Anh");
            doc_dong(q, sizeof(q));
            if (q[0] == '\0') return;
        }

        int kq[MAX_TU];
        int soKq = tim_kiem(q, kq);
        if (soKq > MAX_KETQUA) soKq = MAX_KETQUA;

        in_tieu_de("KẾT QUẢ TRA CỨU");
        if (soKq == 0) {
            printf("%s🔍 Không tìm thấy từ \"%s\"%s\n", mau->xau, q, RESET);
            printf("Thử đổi từ khóa hoặc đổi chiều từ điển.\n\n");
            q[0] = '\0';
            nhan_enter();
            continue;
        }

        for (int i = 0; i < soKq; i++) {
            Word *w = &app.words[kq[i]];
            printf("%2d. %s%s%s %s%s%s  ->  %s%s%s  %s[%s]%s\n", i + 1,
                   DAM, app.huongViEn ? w->vi : w->en, RESET,
                   mau->phu, w->ipa, RESET,
                   mau->chinh, app.huongViEn ? w->en : w->vi, RESET,
                   mau->phu, w->topic, RESET);
        }
        printf("\nChọn số để xem chi tiết (0 = tra từ khác): ");
        int c = doc_so();
        q[0] = '\0';                               // lần sau hỏi từ khóa mới
        if (c >= 1 && c <= soKq) man_hinh_chi_tiet(kq[c - 1]);
    }
}

/* ---------- 2. Thẻ từ (flashcard) ---------- */
#define MAX_THE (MAX_TU * 20)

void man_hinh_flashcard(void) {
    static int ds[MAX_THE];     // danh sách thẻ (lưu vị trí từ)
    int soThe = 0;
    int idx = 0;                // đang ở thẻ thứ mấy
    int lat = 0;                // 0: mặt trước, 1: mặt sau

    // Tạo bộ thẻ: lấy các từ trong chủ đề rồi xáo trộn
    for (int i = 0; i < app.soTu; i++) if (trong_chu_de(&app.words[i])) ds[soThe++] = i;
    if (soThe == 0) {
        in_tieu_de("THẺ TỪ");
        printf("Không có từ vựng nào trong chủ đề này.\n");
        nhan_enter();
        return;
    }
    xao_tron(ds, soThe);

    while (1) {
        in_tieu_de("THẺ TỪ");

        if (idx >= soThe) {                        // hết thẻ
            printf("🎉 Hoàn thành Flashcard! Bạn đã ôn xong chủ đề này.\n\n");
            printf("1. Học lại từ đầu   0. Thoát\nChọn: ");
            if (doc_so() == 1) {
                soThe = 0;
                for (int i = 0; i < app.soTu; i++) if (trong_chu_de(&app.words[i])) ds[soThe++] = i;
                xao_tron(ds, soThe);
                idx = 0;
                lat = 0;
                continue;
            }
            return;
        }

        Word *w = &app.words[ds[idx]];
        printf("%sThẻ %d / %d (%s)%s\n\n", mau->phu, idx + 1, soThe, w->topic, RESET);
        printf("+------------------------------------------+\n");
        if (!lat) {                                // mặt trước
            printf("   %s%s%s%s\n", mau->chinh, DAM, w->en, RESET);
            printf("   %s%s%s\n", mau->phu, w->ipa, RESET);
            printf("   (Chọn 1 để lật xem nghĩa)\n");
        } else {                                   // mặt sau
            printf("   %s%s%s\n", mau->phu, w->pos, RESET);
            printf("   %s%s%s%s\n", mau->chinh, DAM, w->vi, RESET);
            if (w->ex[0]) printf("   \"%s\"\n", w->ex);
        }
        printf("+------------------------------------------+\n\n");

        printf("1. Lật thẻ  2. Chưa thuộc  3. Đã thuộc  4. Đọc  5. Xáo trộn  0. Thoát\nChọn: ");
        int c = doc_so();
        if (c == 0) return;
        if (c == 1) lat = !lat;
        if (c == 2) {                              // chưa thuộc -> đưa thẻ xuống cuối để ôn lại
            if (soThe < MAX_THE) ds[soThe++] = ds[idx];
            idx++;
            lat = 0;
        }
        if (c == 3) { idx++; lat = 0; }            // đã thuộc -> qua thẻ khác
        if (c == 4) { phat_am(w->en, 0); nhan_enter(); }
        if (c == 5) {                              // xáo trộn lại từ đầu
            soThe = 0;
            for (int i = 0; i < app.soTu; i++) if (trong_chu_de(&app.words[i])) ds[soThe++] = i;
            xao_tron(ds, soThe);
            idx = 0;
            lat = 0;
        }
    }
}

/* ---------- 3. Đố vui ---------- */
void man_hinh_quiz(void) {
    int ds[MAX_TU];
    int soCauHoi = 0;
    for (int i = 0; i < app.soTu; i++) if (trong_chu_de(&app.words[i])) ds[soCauHoi++] = i;

    if (soCauHoi < 4) {
        in_tieu_de("ĐỐ VUI");
        printf("Cần ít nhất 4 từ vựng trong chủ đề này để làm đố vui.\n");
        nhan_enter();
        return;
    }

    while (1) {
        xao_tron(ds, soCauHoi);
        if (soCauHoi > 10) soCauHoi = 10;          // mỗi lượt tối đa 10 câu
        int diem = 0;

        for (int cau = 0; cau < soCauHoi; cau++) {
            int dung = ds[cau];                    // vị trí từ cần hỏi
            int opt[4];                            // 4 đáp án (vị trí các từ)
            opt[0] = dung;
            int dem = 1;
            while (dem < 4) {                      // chọn 3 đáp án nhiễu, không trùng nhau
                int r = rand() % app.soTu;
                int trung = 0;
                for (int k = 0; k < dem; k++) if (opt[k] == r) trung = 1;
                if (!trung) opt[dem++] = r;
            }
            xao_tron(opt, 4);

            in_tieu_de("ĐỐ VUI");
            printf("Câu %d / %d          Điểm: %s%d%s\n\n", cau + 1, soCauHoi, mau->chinh, diem, RESET);
            printf("Nghĩa của từ này là gì?\n");
            printf("  %s%s%s%s  %s%s%s\n\n", mau->chinh, DAM, app.words[dung].en, RESET,
                   mau->phu, app.words[dung].ipa, RESET);
            for (int k = 0; k < 4; k++) {
                printf("  %c. %s %s(%s)%s\n", 'A' + k, app.words[opt[k]].vi,
                       mau->phu, app.words[opt[k]].pos, RESET);
            }

            int chon = -1;
            while (chon < 0) {                     // nhập A-D cho đến khi hợp lệ
                char buf[16];
                printf("\nĐáp án của bạn (A/B/C/D): ");
                doc_dong(buf, sizeof(buf));
                char ch = (char)toupper((unsigned char)buf[0]);
                if (ch >= 'A' && ch <= 'D') chon = ch - 'A';
            }

            if (opt[chon] == dung) {
                printf("%s✅ Chính xác!%s\n", mau->tot, RESET);
                diem++;
            } else {
                printf("%s❌ Sai rồi.%s Đáp án đúng: %s%s%s\n", mau->xau, RESET, DAM, app.words[dung].vi, RESET);
            }
            nhan_enter();
        }

        in_tieu_de("KẾT QUẢ TRẮC NGHIỆM");
        printf("🏆 Đúng %s%d / %d%s câu\n\n", mau->chinh, diem, soCauHoi, RESET);
        printf("1. Thử lại lượt mới   0. Thoát\nChọn: ");
        if (doc_so() != 1) return;

        soCauHoi = 0;                              // tạo lại danh sách câu hỏi cho lượt mới
        for (int i = 0; i < app.soTu; i++) if (trong_chu_de(&app.words[i])) ds[soCauHoi++] = i;
    }
}

/* ---------- 4. Đã lưu ---------- */
void man_hinh_yeu_thich(void) {
    while (1) {
