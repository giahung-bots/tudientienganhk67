        printf("1. Thêm từ mới\n2. Xem danh sách / xóa từ\n3. Khôi phục từ vựng gốc\n4. Đăng xuất\n0. Quay lại\nChọn: ");
        int c = doc_so();
        if (c == 0) return;
        if (c == 1) admin_them_tu();
        if (c == 2) admin_xoa_tu();
        if (c == 3 && hoi_co_khong("Khôi phục danh sách từ vựng ban đầu?")) {
            khoi_phuc_tu_goc();
            printf("Đã khôi phục dữ liệu gốc.\n");
            nhan_enter();
        }
        if (c == 4) {
            app.isAdmin = 0;
            return;
        }
    }
}

/* ---------- Chọn chủ đề ---------- */
void chon_chu_de(void) {
    in_tieu_de("CHỌN CHỦ ĐỀ");
    printf("0. Tất cả\n");
    for (int i = 0; i < SO_CHU_DE; i++) printf("%d. %s\n", i + 1, CHU_DE[i]);
    printf("Chọn: ");
    int c = doc_so();
    if (c >= 0 && c <= SO_CHU_DE) app.chuDe = c - 1;    // c = 0 -> -1 (tất cả)
}

