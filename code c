/* ---------- 5. Lịch sử ---------- */
void man_hinh_lich_su(void) {
    while (1) {
        in_tieu_de("LỊCH SỬ TRA CỨU");
        if (app.soHist == 0) {
            printf("Lịch sử tra cứu trống.\n");
            nhan_enter();
