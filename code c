/* ============================================================
 *  PHẦN C: HÀM XỬ LÝ DỮ LIỆU (chủ đề, yêu thích, lịch sử, tìm kiếm)
 * ============================================================ */

// Từ w có thuộc chủ đề đang chọn không?
int trong_chu_de(const Word *w) {
    if (app.chuDe < 0) return 1;
    return strcmp(w->topic, CHU_DE[app.chuDe]) == 0;
}

int dem_tu_trong_chu_de(void) {
    int dem = 0;
    for (int i = 0; i < app.soTu; i++) if (trong_chu_de(&app.words[i])) dem++;
    return dem;
}

const char *ten_chu_de(void) {
    return app.chuDe < 0 ? "Tất cả" : CHU_DE[app.chuDe];
}

// Trộn ngẫu nhiên một mảng số nguyên (thuật toán Fisher-Yates)
void xao_tron(int *mang, int n) {
    for (int i = n - 1; i > 0; i--) {
        int j = rand() % (i + 1);
        int tam = mang[i];
        mang[i] = mang[j];
        mang[j] = tam;
    }
}

/* ----- Yêu thích ----- */
int tim_yeu_thich(const char *en) {          // trả về vị trí, hoặc -1 nếu chưa có
    char k[50];
    viet_thuong(en, k, sizeof(k));
    for (int i = 0; i < app.soFav; i++) if (strcmp(app.favs[i], k) == 0) return i;
    return -1;
}

void them_yeu_thich(const char *en) {
    if (tim_yeu_thich(en) >= 0 || app.soFav >= MAX_YEUTHICH) return;
    for (int i = app.soFav; i > 0; i--) strcpy(app.favs[i], app.favs[i - 1]);   // chèn vào đầu
    viet_thuong(en, app.favs[0], 50);
    app.soFav++;
    luu_yeu_thich();
}

void bo_yeu_thich(const char *en) {
    int vt = tim_yeu_thich(en);
    if (vt < 0) return;
    for (int i = vt; i < app.soFav - 1; i++) strcpy(app.favs[i], app.favs[i + 1]);
    app.soFav--;
    luu_yeu_thich();
}

/* ----- Lịch sử ----- */
void them_lich_su(const char *en) {
    int vt = -1;                                         // đã có trong lịch sử chưa?
    for (int i = 0; i < app.soHist; i++) if (strcmp(app.hist[i], en) == 0) vt = i;
    if (vt >= 0) {                                       // có rồi -> xóa bản cũ
        for (int i = vt; i < app.soHist - 1; i++) strcpy(app.hist[i], app.hist[i + 1]);
        app.soHist--;
    }
    if (app.soHist >= MAX_LICHSU) app.soHist = MAX_LICHSU - 1;
    for (int i = app.soHist; i > 0; i--) strcpy(app.hist[i], app.hist[i - 1]);
    sao_chep(app.hist[0], en, 50);
    app.soHist++;
    luu_lich_su();
}

/* ----- Tìm kiếm -----
 * Điểm: 0 = trùng khớp hoàn toàn, 1 = bắt đầu bằng, 2 = có chứa, 9 = không khớp
 * Kết quả (vị trí các từ) xếp vào mảng kq, đã sắp theo điểm. Trả về số kết quả. */
int tim_kiem(const char *tuKhoa, int kq[]) {
    static int diem[MAX_TU];
    char n[300], k[300];
    chuan_hoa(tuKhoa, n, sizeof(n));

    int dem = 0;
    for (int i = 0; i < app.soTu; i++) {
        Word *w = &app.words[i];
        if (!trong_chu_de(w)) continue;
        chuan_hoa(app.huongViEn ? w->vi : w->en, k, sizeof(k));

        int d = 9;
        if (strcmp(k, n) == 0) d = 0;
        else if (strncmp(k, n, strlen(n)) == 0) d = 1;
        else if (strstr(k, n) != NULL) d = 2;

        if (d < 9) {
            kq[dem] = i;
            diem[dem] = d;
            dem++;
        }
    }

    // Sắp xếp nổi bọt: điểm nhỏ lên trước, bằng điểm thì theo thứ tự chữ cái
    for (int a = 0; a < dem - 1; a++) {
        for (int b = 0; b < dem - 1 - a; b++) {
            int doiCho = 0;
            if (diem[b] > diem[b + 1]) doiCho = 1;
            else if (diem[b] == diem[b + 1] &&
                     so_sanh_khong_hoa_thuong(app.words[kq[b]].en, app.words[kq[b + 1]].en) > 0) doiCho = 1;
            if (doiCho) {
                int t = kq[b]; kq[b] = kq[b + 1]; kq[b + 1] = t;
                t = diem[b]; diem[b] = diem[b + 1]; diem[b + 1] = t;
            }
        }
    }
    return dem;
}

