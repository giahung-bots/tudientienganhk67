// Cắt một dòng "a|b|c" thành các phần. Trả về số phần tách được.
int tach_dong(char *dong, char *phan[], int toiDa) {
    int n = 0;
    char *p = dong;
    phan[n++] = p;
    while (*p && n < toiDa) {
        if (*p == '|') {
            *p = '\0';
            phan[n++] = p + 1;
        }
        p++;
    }
    return n;
}

void doc_tu_tu_file(void) {
    app.soTu = 0;
    FILE *f = fopen(FILE_TU, "r");
    if (f) {
        char dong[1024];
        while (app.soTu < MAX_TU && fgets(dong, sizeof(dong), f)) {
            int len = (int)strlen(dong);
            while (len > 0 && (dong[len - 1] == '\n' || dong[len - 1] == '\r')) dong[--len] = '\0';
            char *p[7];
            if (tach_dong(dong, p, 7) < 7) continue;       // dòng hỏng thì bỏ qua
            Word *w = &app.words[app.soTu++];
            sao_chep(w->en,    p[0], sizeof(w->en));
            sao_chep(w->ipa,   p[1], sizeof(w->ipa));
            sao_chep(w->pos,   p[2], sizeof(w->pos));
            sao_chep(w->vi,    p[3], sizeof(w->vi));
            sao_chep(w->ex,    p[4], sizeof(w->ex));
            sao_chep(w->exVi,  p[5], sizeof(w->exVi));
            sao_chep(w->topic, p[6], sizeof(w->topic));
        }
        fclose(f);
    }
    if (app.soTu == 0) khoi_phuc_tu_goc();                 // chưa có file -> dùng dữ liệu gốc
}

void doc_danh_sach_chuoi(const char *tenFile, char ds[][50], int *dem, int toiDa) {
    *dem = 0;
    FILE *f = fopen(tenFile, "r");
    if (!f) return;
    char dong[200];
    while (*dem < toiDa && fgets(dong, sizeof(dong), f)) {
        int len = (int)strlen(dong);
        while (len > 0 && (dong[len - 1] == '\n' || dong[len - 1] == '\r')) dong[--len] = '\0';
        if (len > 0) sao_chep(ds[(*dem)++], dong, 50);
    }
    fclose(f);
