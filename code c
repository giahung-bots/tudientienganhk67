// So sánh 2 chuỗi không phân biệt hoa thường
int so_sanh_khong_hoa_thuong(const char *a, const char *b) {
    while (*a && *b) {
        int x = tolower((unsigned char)*a);
        int y = tolower((unsigned char)*b);
        if (x != y) return x - y;
        a++;
        b++;
    }
    return tolower((unsigned char)*a) - tolower((unsigned char)*b);
}

// Đổi sang chữ thường
void viet_thuong(const char *nguon, char *dich, int n) {
    int i = 0;
    for (; nguon[i] && i < n - 1; i++) dich[i] = (char)tolower((unsigned char)nguon[i]);
    dich[i] = '\0';
}

/* ----- Bỏ dấu tiếng Việt (để gõ "tinh yeu" vẫn tìm ra "tình yêu") -----
 * Mỗi nhóm gồm các chữ có dấu và chữ gốc của chúng.
 * Chữ tiếng Việt dùng UTF-8 nên mỗi chữ có thể chiếm 2-3 byte. */
typedef struct {
    const char *chuoi;   // các chữ có dấu thuộc nhóm
    char goc;            // chữ không dấu tương ứng
} NhomDau;

static const NhomDau BANG_DAU[] = {
    {"àáảãạăằắẳẵặâầấẩẫậÀÁẢÃẠĂẰẮẲẴẶÂẦẤẨẪẬ", 'a'},
    {"èéẻẽẹêềếểễệÈÉẺẼẸÊỀẾỂỄỆ", 'e'},
    {"ìíỉĩịÌÍỈĨỊ", 'i'},
    {"òóỏõọôồốổỗộơờớởỡợÒÓỎÕỌÔỒỐỔỖỘƠỜỚỞỠỢ", 'o'},
    {"ùúủũụưừứửữựÙÚỦŨỤƯỪỨỬỮỰ", 'u'},
    {"ỳýỷỹỵỲÝỶỸỴ", 'y'},
    {"đĐ", 'd'}
};
#define SO_NHOM ((int)(sizeof(BANG_DAU) / sizeof(BANG_DAU[0])))

// Một ký tự UTF-8 chiếm bao nhiêu byte? (nhìn byte đầu tiên)
int do_dai_utf8(unsigned char c) {
    if (c < 0x80) return 1;
    if ((c >> 5) == 0x6) return 2;
    if ((c >> 4) == 0xE) return 3;
    if ((c >> 3) == 0x1E) return 4;
    return 1;
}

// Tìm chữ gốc của ký tự UTF-8 dài `len` byte tại vị trí p. Không có thì trả 0.
char tim_chu_goc(const char *p, int len) {
    for (int g = 0; g < SO_NHOM; g++) {
        const char *s = BANG_DAU[g].chuoi;
        while (*s) {
            int l = do_dai_utf8((unsigned char)*s);
            if (l == len && memcmp(s, p, len) == 0) return BANG_DAU[g].goc;
            s += l;
        }
    }
    return 0;
}

// Chuẩn hóa: chữ thường + bỏ dấu + cắt khoảng trắng 2 đầu
void chuan_hoa(const char *nguon, char *dich, int n) {
    char tam[300];
    int k = 0;
    const char *p = nguon;
    while (*p && k < (int)sizeof(tam) - 1) {
        int len = do_dai_utf8((unsigned char)*p);
        char goc = (len > 1) ? tim_chu_goc(p, len) : 0;
        if (goc) {
            tam[k++] = goc;
        } else if (len == 1) {
            tam[k++] = (char)tolower((unsigned char)*p);
        } else {                                   // ký tự lạ: giữ nguyên
            for (int i = 0; i < len && k < (int)sizeof(tam) - 1; i++) tam[k++] = p[i];
        }
        p += len;
    }
    tam[k] = '\0';

    int dau = 0, cuoi = k - 1;                     // cắt khoảng trắng
    while (tam[dau] == ' ') dau++;
    while (cuoi >= dau && tam[cuoi] == ' ') cuoi--;
    int j = 0;
    for (int i = dau; i <= cuoi && j < n - 1; i++) dich[j++] = tam[i];
    dich[j] = '\0';
}

/* ----- Đọc phát âm (dùng chương trình có sẵn của hệ điều hành) ----- */
void phat_am(const char *text, int tiengViet) {
    char sach[200];
    int n = 0;
    for (int i = 0; text[i] && n < (int)sizeof(sach) - 1; i++) {
        char c = text[i];
        if (strchr("'\"\\`$&;|<>%()", c)) continue;   // bỏ ký tự nguy hiểm cho lệnh
        sach[n++] = c;
    }
    sach[n] = '\0';

    char lenh[600];
#ifdef _WIN32
    snprintf(lenh, sizeof(lenh),
        "powershell -NoProfile -Command \"Add-Type -AssemblyName System.Speech; "
        "(New-Object System.Speech.Synthesis.SpeechSynthesizer).Speak('%s')\"", sach);
#elif defined(__APPLE__)
    snprintf(lenh, sizeof(lenh), "say %s \"%s\"", tiengViet ? "-v Linh" : "", sach);
#else
    snprintf(lenh, sizeof(lenh), "espeak -v %s \"%s\" 2>/dev/null", tiengViet ? "vi" : "en", sach);
#endif
    if (system(lenh) != 0) {
        printf("%sMáy chưa hỗ trợ đọc phát âm (Linux cần cài espeak).%s\n", mau->xau, RESET);
    }
}

